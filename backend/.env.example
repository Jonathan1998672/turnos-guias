# Cadena de conexión de Supabase.
# Project Settings -> Database -> Connection string -> URI
#
# En desarrollo usa la conexión directa (puerto 5432). Si usas el pooler en modo
# transacción (puerto 6543), el backend desactiva solo los prepared statements.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true imprime el SQL generado en la consola.
DEBUG=false
